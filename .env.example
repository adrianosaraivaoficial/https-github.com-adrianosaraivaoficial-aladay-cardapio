# =============================================================================
# MODELO DE VARIÁVEIS DE AMBIENTE — ALADAY
# Copie para o ambiente do serviço no EasyPanel e substitua TODOS os exemplos.
# Nunca versione o arquivo .env real.
# =============================================================================

PORT=3000
NODE_ENV=production

# PostgreSQL
DATABASE_URL=postgresql://USUARIO:SENHA_FORTE@HOST_POSTGRES:5432/aladay
PGSSLMODE=disable

# Obrigatório em produção: gere com: openssl rand -hex 48
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES

# Conta administrativa inicial. Use senha forte (mínimo 12 caracteres).
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PHONE=5511999999999
ADMIN_PASSWORD=SUBSTITUA_POR_SENHA_FORTE_UNICA

# Evolution API — credenciais somente no ambiente do servidor.
EVOLUTION_API_URL=https://SUA-EVOLUTION-API
EVOLUTION_API_KEY=SUBSTITUA_PELA_CHAVE_DA_EVOLUTION
EVOLUTION_DEFAULT_INSTANCE=aladay

# Token exclusivo para autenticar notificações Pix recebidas pelo endpoint.
# Configure o mesmo valor no provedor que envia o webhook.
PIX_WEBHOOK_TOKEN=SUBSTITUA_POR_TOKEN_ALEATORIO_FORTE

# n8n (opcional)
N8N_WEBHOOK_URL=https://SEU-N8N/webhook/whatsapp-inbound

# Asaas
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
