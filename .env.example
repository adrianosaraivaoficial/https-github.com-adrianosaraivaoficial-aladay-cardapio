# =============================================================================
# VARIÁVEIS DE AMBIENTE PARA O EASYPANEL (VPS)
# Copie e cole na aba "Environment" do serviço do Site no EasyPanel
# =============================================================================

# 1. Porta e Ambiente da Aplicação
PORT=3000
NODE_ENV=production

# 2. Conexão com o Banco de Dados PostgreSQL no EasyPanel
# Formato interno do EasyPanel: postgresql://USUARIO:SENHA@NOME_DO_PROJETO_NOME_DO_SERVICO_POSTGRES:5432/NOME_DO_BANCO
DATABASE_URL=postgresql://postgres:SUA_SENHA_FORTE_AQUI@aladay_postgres:5432/aladay
PGSSLMODE=disable

# 3. Segurança JWT (Autenticação Multi-Tenant de Restaurantes e Super Admin)
JWT_SECRET=troque_por_uma_chave_secreta_aleatoria_de_64_caracteres_na_vps

# 4. Integração WhatsApp Evolution API (Rodando no EasyPanel)
EVOLUTION_API_URL=https://agencia-evolution-api.2eoc7n.easypanel.host
EVOLUTION_API_KEY=21C3D49F3F00-48FA-BFA2-2CD290850405
EVOLUTION_DEFAULT_INSTANCE=aladay

# 5. Integração n8n (Automação de Atendimento no EasyPanel)
N8N_WEBHOOK_URL=https://agencia-n8n.2eoc7n.easypanel.host/webhook/whatsapp-inbound

# 6. Gateway Asaas (Exclusivo para Mensalidades R$ 129,90 do SaaS Aladay)
ASAAS_ENVIRONMENT=production
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
