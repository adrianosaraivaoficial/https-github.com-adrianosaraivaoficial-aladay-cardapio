# =============================================================================
# ARQUIVO DE CONFIGURAÇÃO DE SEGURANÇA E CHAVES DE API (.ENV)
# Copie este arquivo para ".env" (ou cole na aba Environment do EasyPanel)
# NUNCA adicione chaves reais no código-fonte (src/ ou server.ts)
# =============================================================================

# 1. Porta e Ambiente da Aplicação
PORT=3000
NODE_ENV=production
APP_URL=https://aladay.com.br

# 2. Conexão com o Banco de Dados PostgreSQL (EasyPanel)
# Formato interno do EasyPanel: postgresql://USUARIO:SENHA@NOME_PROJETO_NOME_SERVICO:5432/NOME_BANCO
DATABASE_URL=postgresql://postgres:SUA_SENHA_FORTE_AQUI@agencia_agpostgres:5432/agencia
PGSSLMODE=disable

# 3. Segurança Criptográfica JWT e Credenciais de Super Admin
# Gere uma chave aleatória forte (ex: openssl rand -hex 32)
JWT_SECRET=substitua_por_uma_chave_secreta_aleatoria_de_64_caracteres
ADMIN_EMAIL=admin@aladay.com.br
ADMIN_PASSWORD=substitua_por_uma_senha_forte_de_super_admin
PIX_WEBHOOK_SECRET=substitua_pelo_token_secreto_de_webhook_pix

# 4. Integração WhatsApp Evolution API (Apenas no Backend / .env)
EVOLUTION_API_URL=https://sua-evolution-api.easypanel.host
EVOLUTION_API_KEY=SUA_GLOBAL_API_KEY_EVOLUTION_AQUI
EVOLUTION_DEFAULT_INSTANCE=aladay

# 5. Integração n8n (Automação de Atendimento no Backend / .env)
N8N_WEBHOOK_URL=https://seu-n8n.easypanel.host/webhook/whatsapp-inbound

# 6. Gateway Asaas (Cobrança de Assinaturas SaaS Aladay)
ASAAS_ENVIRONMENT=production
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_PIX_KEY=+559131976334
ASAAS_PIX_BENEFICIARY=ALADAY CARDAPIOS
ASAAS_PIX_CITY=BELEM

# 7. Integração Oficial iFood Partner API (Opcional - Credenciais da Plataforma)
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
